# Kopiera till miljövariabler i molntjänsten (Render → Environment). Lägg ALDRIG riktiga värden i git.

# Lång slumpad sträng. Kindlen hämtar https://<din-tjänst>/dash.png?key=<DASH_KEY>
DASH_KEY=

# Västtrafik Planera Resa v4 – från developer.vasttrafik.se
VT_CLIENT_ID=
VT_CLIENT_SECRET=
VT_STOP_NAME=Järntorget
# VT_STOP_GID=            # valfritt, slås upp automatiskt
# Jobbresor: LINJE[@del av riktningen][:Namn], kommaseparerat
#   t.ex. X2@Kungälv:Victor,1@Östra:Lovisa  (utan @ visas båda riktningarna)
VT_WORK=X2@Billdal:Victor,1@Östra:Lovisa
# Läget som visas efter omstart: jobb eller alla
DEFAULT_MODE=jobb
VT_WORK_TIMES=4
# Byte: LINJE=BYTESHÅLLPLATS:NÄSTA LINJE[@riktning]:ÅKTID I MINUTER
VT_CONNECTIONS=X2=Linnéplatsen:25@Balltorp:4
# Minuter du behöver för att gå mellan hållplatslägena vid bytet
VT_CHANGE_MINUTES=1
# "Alla avgångar": vilka trafikslag (tram,bus,ferry,train) – tomt = allt
VT_MODES=
# Dölj riktningar i "Alla avgångar" som innehåller dessa ord
VT_HIDE_DIRECTIONS=
VT_TIMES_PER_ROW=3

# Väder (Yr / MET Norway, ingen nyckel)
LAT=57.6997
LON=11.9527
WEATHER_PLACE=Göteborg

# Google Keep – använd ett separat Google-konto som listan delas med
KEEP_EMAIL=
KEEP_MASTER_TOKEN=
KEEP_NOTE_TITLE=Att köpa

# 1 = visa exempeldata för källor som inte är inställda än
DEMO_WHEN_UNCONFIGURED=1
